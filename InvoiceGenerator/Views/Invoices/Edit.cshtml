@model InvoiceGenerator.Models.Invoice

@{
    ViewData["Title"] = "Edit Invoice";
    var lineItems = Model.LineItems.ToList();
}

<h1>Edit Invoice</h1>

<h4>Invoice</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClientId" class="control-label"></label>
                <select asp-for="ClientId" class="form-control" asp-items="ViewBag.ClientId"></select>
            </div>
            <div class="form-group">
                <label>Line Items</label>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                        </tr>
                    </thead>
                    <tbody id="lineItems">
                        @for (int i = 0; i < lineItems.Count; i++)
                        {
                            <tr>
                                <td><input name="LineItems[@i].Description" value="@lineItems[i].Description" class="form-control" /></td>
                                <td><input name="LineItems[@i].Quantity" value="@lineItems[i].Quantity" class="form-control" type="number" /></td>
                                <td><input name="LineItems[@i].UnitPrice" value="@lineItems[i].UnitPrice" class="form-control" type="number" step="0.01" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button type="button" id="addLineItem" class="btn btn-secondary">Add Line Item</button>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let lineItemCount = @lineItems.Count;
        document.getElementById("addLineItem").addEventListener("click", function () {
            let table = document.getElementById("lineItems");
            let row = table.insertRow();
            row.innerHTML = `
                        <td><input name="LineItems[${lineItemCount}].Description" class="form-control" /></td>
                        <td><input name="LineItems[${lineItemCount}].Quantity" class="form-control" type="number" /></td>
                        <td><input name="LineItems[${lineItemCount}].UnitPrice" class="form-control" type="number" step="0.01" /></td>
                    `;
            lineItemCount++;
        });
    </script>
}
